{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifequest-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifequest-push",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://thatstej45.github.io",
    "VAPID_SUBJECT": "https://thatstej45.github.io/lifequest/",
    "VAPID_PUBLIC_KEY": "REPLACE_WITH_VAPID_PUBLIC_KEY"
  }
}
