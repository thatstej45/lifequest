# frozen_string_literal: true

require 'base64'

default_platform(:ios)

BUNDLE_ID = 'com.lifequest.app'
XCODEPROJ = 'App/App.xcodeproj'
SCHEME = 'App'

platform :ios do
  desc 'Archive LifeQuest and upload the IPA to TestFlight'
  lane :beta do
    required = %w[
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_KEY
      APPLE_TEAM_ID
    ]
    missing = required.select { |key| ENV[key].to_s.strip.empty? }
    UI.user_error!("Missing env: #{missing.join(', ')}") unless missing.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_KEY'],
      is_key_content_base64: ENV['APP_STORE_CONNECT_KEY_IS_BASE64'] != 'false'
    )

    setup_ci if is_ci

    if ENV['IOS_DIST_P12_BASE64'].to_s.strip != ''
      p12_path = File.expand_path('build_certificate.p12')
      File.binwrite(p12_path, Base64.decode64(ENV['IOS_DIST_P12_BASE64']))
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV.fetch('IOS_DIST_P12_PASSWORD', ''),
        keychain_name: ENV['MATCH_KEYCHAIN_NAME'],
        keychain_password: ENV['MATCH_KEYCHAIN_PASSWORD']
      )
    elsif is_ci
      UI.user_error!(
        'CI TestFlight uploads need IOS_DIST_P12_BASE64 (Apple Distribution .p12). ' \
        'Or archive once from Xcode on a Mac instead.'
      )
    end

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      provisioning_name: ENV.fetch('IOS_PROFILE_NAME', 'LifeQuest AppStore'),
      fail_on_name_taken: false,
      readonly: false
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV['APPLE_TEAM_ID'],
      bundle_identifier: BUNDLE_ID,
      code_sign_identity: 'Apple Distribution',
      profile_name: profile_name
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: 'build',
      output_name: 'LifeQuest.ipa',
      export_team_id: ENV['APPLE_TEAM_ID'],
      export_options: {
        method: 'app-store',
        signingStyle: 'manual',
        teamID: ENV['APPLE_TEAM_ID'],
        provisioningProfiles: {
          BUNDLE_ID => profile_name
        }
      },
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV['TESTFLIGHT_CHANGELOG'] || 'LifeQuest build'
    )
  end
end
